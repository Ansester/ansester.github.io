---
import comparison from '../data/protein-comparison.json';
const [min, max] = [81, 88];
const x = (value: number) => `${((value-min)/(max-min)*100).toFixed(2)}%`;
const span = (sd: number) => `${(sd*2/(max-min)*100).toFixed(2)}%`;
const key = 'BLOSUM62 + LoRA';
const keyMethod = comparison.methods.find(method=>method.shortName===key)!;
const summary = comparison.methods.map(method=>`${method.shortName} ${method.mean.toFixed(2)}%`).join(', ');
---
  <figure class="protein-comparison" id="recorded-comparison">
    <p class="figure-heading">Follow-up experiment, {comparison.model}</p>
    <div class="dot-plot" role="img" aria-label={`Mean exact cleavage-site match across three seeds: ${summary}. Error bars show sample standard deviation.`}>
      {comparison.methods.map(method=>{
        const isKey = method===keyMethod;
        return <div class:list={['plot-row',{'is-key':isKey}]} title={`${method.name}: ${method.mean.toFixed(2)}% ± ${method.sd.toFixed(2)} percentage points`}>
          <span class="plot-label">{method.shortName}</span>
          <span class="plot-track">
            {[82,84,86,88].map(tick=><i class="grid" style={`left:${x(tick)}`}></i>)}
            <i class:list={['whisker',{'is-key':isKey}]} style={`left:${x(method.mean-method.sd)};width:${span(method.sd)}`}></i>
            <i class:list={['dot',{'is-key':isKey}]} style={`left:${x(method.mean)}`}></i>
          </span>
          <span class="plot-value">{method.mean.toFixed(2)}%</span>
        </div>;
      })}
      <div class="plot-row plot-axis" aria-hidden="true"><span class="plot-label"></span><span class="plot-track">{[82,84,86,88].map(tick=><span class="tick" style={`left:${x(tick)}`}>{tick}%</span>)}</span><span class="plot-value"></span></div>
    </div>
    <figcaption>Exact cleavage-site match. Mean ± sample SD across three seeds, {comparison.positiveExamples.toLocaleString('en-US')} signal-peptide-positive examples. Full fine-tuning led at 150M and 3B. Feature injection is separate from the manuscript’s initialization method. The error bars do not establish statistical significance.</figcaption>
    <details class="result-details"><summary>Data and evaluation scope</summary><table><thead><tr><th scope="col">Method</th><th scope="col">Mean ± SD</th></tr></thead><tbody>{comparison.methods.map(row=><tr><th scope="row">{row.name}</th><td>{row.mean.toFixed(2)}% ± {row.sd.toFixed(2)} pp</td></tr>)}</tbody></table><p>SP5; seeds {comparison.seeds.join(', ')}. Exact match is measured on the true signal-peptide-positive subset. The error bars are sample standard deviations in percentage points, not confidence intervals.</p><a href="/research/protein-comparison.csv" download>Download the summary data (CSV)</a></details>
  </figure>
