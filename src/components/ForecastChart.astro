---
import '../styles/forecast-table.css';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const noChange = { label: 'Predict no change', score: 7.14, group: 'baseline', selected: false };
const forecasts = [
  { label: 'Elastic net', score: 4.52, group: 'regression', selected: true },
  { label: 'Ordinary linear regression', score: 5.22, group: 'regression', selected: false },
  { label: 'Claude Haiku 4.5', score: 6.21, group: 'model', selected: true },
  { label: 'Lay crowd', score: 6.42, group: 'crowd', selected: true },
  { label: 'Expert crowd', score: 6.55, group: 'crowd', selected: true },
  { label: 'Claude Sonnet 4.5', score: 6.62, group: 'model', selected: false },
  { label: 'Claude Sonnet 5.5', score: 6.65, group: 'model', selected: false },
  noChange,
  { label: 'GPT-5', score: 9.28, group: 'model', selected: false },
];
const rows = compact ? forecasts.filter(row => row.selected) : forecasts;
const scaleMax = 10;
const position = (value: number) => `${(value / scaleMax * 100).toFixed(1)}%`;
---
<div class="forecast-chart" style={`--reference-position:${position(noChange.score)}`}>
  <table class="forecast-table">
    <caption>Forecast error across the 20 designs, in percentage points. Lower is better.</caption>
    <thead>
      <tr>
        <th scope="col">Forecast</th>
        <th scope="col">RMSE</th>
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr data-group={row.group}>
          <th scope="row">{row.label}</th>
          <td>
            <div class="forecast-reading">
              <span class="forecast-track" aria-hidden="true">
                <span class="forecast-bar" style={`width:${position(row.score)}`}></span>
              </span>
              <span>{row.score.toFixed(2)}</span>
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="forecast-foot">
    <span class="forecast-key">Predict no change · {noChange.score.toFixed(2)}</span>
    {compact && <a href="/work/synthetic-pilot-lab/#scoring-the-forecasts">All eight forecasters</a>}
  </div>
</div>
