---
import '../styles/global.css';
import { affiliation, researchProjects, researchQuestion } from '../data/profile';
interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  title = 'Ashmit Mukherjee · NYU Abu Dhabi',
  description = `${affiliation}. ${researchQuestion}`,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isResearch = researchProjects.some(id => path === `/work/${id}/`);
const projectsCurrent = path === '/work/' ? 'page' : path.startsWith('/work/') && !isResearch ? 'location' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://ashmitmukherjee.com/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ashmitmukherjee.com/social-card.png" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person', name: 'Ashmit Mukherjee',
      url: 'https://ashmitmukherjee.com/', jobTitle: 'Computer science undergraduate', description: researchQuestion,
      affiliation: { '@type': 'CollegeOrUniversity', name: 'New York University Abu Dhabi' },
      email: 'mailto:asm8879@nyu.edu',
      sameAs: ['https://github.com/Ansester'],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Ashmit Mukherjee, home" aria-current={path === '/' ? 'page' : undefined}><span>Ashmit Mukherjee</span></a>
        <nav aria-label="Main navigation">
          <a href="/#research" aria-current={isResearch ? 'location' : undefined}>Research</a>
          <a href="/work/" aria-current={projectsCurrent}>Projects</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container" id="contact">
      <div class="contact-heading"><h2>Contact</h2><Fragment set:html={'<!--email_off--><a class="contact-email" href="mailto:asm8879@nyu.edu">asm8879@nyu.edu</a><!--/email_off-->'} /></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Ashmit Mukherjee</span><div><a href="https://github.com/Ansester">GitHub</a><button class="copy-email" type="button" hidden>Copy email</button></div></div>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </footer>
    <script>
      const copy = document.querySelector<HTMLButtonElement>('.copy-email');
      const status = document.querySelector<HTMLElement>('.copy-status');
      if (copy && status && navigator.clipboard) {
        copy.hidden = false;
        copy.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText('asm8879@nyu.edu'); status.textContent = 'Email address copied.'; }
          catch { status.textContent = 'Select the email address above to copy it, or open it in your mail app.'; }
        });
      }
    </script>
  </body>
</html>
