---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const projects = (await getCollection('work')).sort((a,b)=>a.data.order-b.data.order);
---
<Layout title="Work — Ashmit Mukherjee" description="Research platforms, protein language model evaluation, campus software, and multilingual NLP. Selected work by Ashmit Mukherjee.">
  <div class="container work-page"><header class="page-intro"><p class="eyebrow">Engineering / Research / Applied ML</p><h1>Selected work.</h1><p>Systems I've helped build, methods I've worked with, and how I approach evaluation.</p></header><section aria-label="Case studies">{projects.map((p,i)=><article class="project-row"><span class="project-number">0{i+1}</span><div><p class="eyebrow">{p.data.category}</p><h2><a href={`/work/${p.id}/`}>{p.data.title}</a></h2><p>{p.data.summary}</p><div class="tags">{p.data.tags.map(t=><span>{t}</span>)}<span>{p.data.period}</span></div></div><a class="row-link" href={`/work/${p.id}/`} aria-label={`Read ${p.data.title}`}>↗</a></article>)}</section>
  <section class="section additional-work"><div class="section-head"><h2>Additional projects</h2></div><div class="additional-grid"><article><p class="eyebrow">Applied data science / Fall 2025</p><h3>Salary prediction</h3><p>A workflow on 742 cleaned Glassdoor job listings, combining PyCaret model comparison, XGBoost, SHAP interpretation, MLflow tracking, and Streamlit.</p><a class="text-link" href="https://github.com/Ansester/salary-prediction-ml" target="_blank" rel="noopener noreferrer">Source code ↗</a></article><article><p class="eyebrow">Statistical modeling / Spring 2025</p><h3>Community crime data analysis</h3><p>Regression and single-holdout evaluation across 1,994 U.S. communities, with a Streamlit app for descriptive exploration. Associations are observational, not causal.</p><a class="text-link" href="https://github.com/Ansester/crime-prediction-ml" target="_blank" rel="noopener noreferrer">Source code ↗</a></article></div></section></div>
</Layout>
