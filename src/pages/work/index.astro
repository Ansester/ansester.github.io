---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { researchProjects, softwareProjects } from '../../data/profile';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { title: 'Software and competitions', ids: [...softwareProjects, 'camp'] },
  { title: 'Industry experience', ids: ['zeek'] },
  { title: 'Research', ids: researchProjects },
];
const earlier = projects.filter(project => !groups.some(group => group.ids.includes(project.id)));
---
<Layout title="Projects · Ashmit Mukherjee" description="Software projects, my machine learning internship at Zeek, and research at NYU Abu Dhabi.">
  <div class="container projects-page">
    <header class="page-intro"><h1>Projects</h1></header>
    {groups.map(group => (
      <section class="project-group">
        <h2>{group.title}</h2>
        <div class="project-list">
          {projects.filter(project => group.ids.includes(project.id)).map(project => (
            <article class="project-row">
              <h3><a href={`/work/${project.id}/`}>{project.data.title}</a></h3>
              <p>{project.data.summary}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
    <details class="archive">
      <summary>Earlier projects and coursework</summary>
      <ul>
        {earlier.map(project => <li><a href={`/work/${project.id}/`}>{project.data.title}</a></li>)}
        <li><a href="https://github.com/Ansester/crime-prediction-ml">Community crime data analysis (GitHub)</a></li>
      </ul>
    </details>
  </div>
</Layout>
