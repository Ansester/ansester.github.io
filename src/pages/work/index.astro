---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import fieldlens from '../../../assets/fieldlens-review.png';
const projects = await getCollection('work');
const coursework = ['hinglish-ner','camp'].map(id=>projects.find(p=>p.id===id)!);
---
<Layout title="Projects — Ashmit Mukherjee" description="Independent software and selected coursework: FieldLens, Hinglish named-entity recognition, and CAMP.">
  <div class="container projects-page">
    <header class="page-intro"><h1>Projects</h1><p>Independent software and selected coursework, 2024–2026.<br />My <a href="/#research">current research</a> is on the homepage.</p></header>
    <article class="project-feature"><div><p class="byline">Independent prototype · October 2026</p><h2><a href="/work/fieldlens/">FieldLens</a></h2><p>A local tool for reviewing fictional incident records. A reader can inspect the source records alongside each model answer.</p><p>I set the requirements, defined the evaluation criteria, and reviewed successive prototypes. In synthetic comparisons, some answers cited their sources correctly but still missed information requested by the question.</p><a class="read-link" href="/work/fieldlens/">Design and evaluation</a></div><figure><a href="/work/fieldlens/" aria-label="Read the FieldLens project"><Image src={fieldlens} alt="FieldLens prototype with a model answer and its supporting incident record visible together" width={720} format="webp" /></a><figcaption>Working prototype with fictional incident records.</figcaption></figure></article>
    <section class="coursework" aria-labelledby="coursework-heading"><h2 id="coursework-heading">Selected coursework</h2>{coursework.map(p=><article class="project-row"><div><h3><a href={`/work/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.summary}</p></div><span class="byline">{p.data.period}</span></article>)}
      <article class="project-row"><div><h3><a href="https://github.com/Ansester/salary-prediction-ml" target="_blank" rel="noopener noreferrer">Salary prediction ↗</a></h3><p>Regression on historical Glassdoor listings, with duplicate-aware evaluation and a Streamlit interface.</p></div><span class="byline">Fall 2025</span></article>
      <article class="project-row"><div><h3><a href="https://github.com/Ansester/crime-prediction-ml" target="_blank" rel="noopener noreferrer">Community crime data analysis ↗</a></h3><p>Observational regression and single-holdout evaluation across 1,994 U.S. communities, with an application for descriptive exploration.</p></div><span class="byline">Spring 2025</span></article>
    </section>
  </div>
</Layout>
