---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
const projects = (await getCollection('work')).sort((a,b)=>a.data.order-b.data.order);
const groups = [
  {title:'Research', projects:projects.filter(p=>!['fieldlens','camp'].includes(p.id))},
  {title:'Research engineering & software', projects:projects.filter(p=>['fieldlens','camp'].includes(p.id))},
];
---
<Layout title="Work — Ashmit Mukherjee" description="Human–AI experiments, synthetic piloting, Bio-LoRA, evidence-linked AI tools, and multilingual NLP. Research and engineering work by Ashmit Mukherjee.">
  <div class="container work-page">
    <header class="page-intro"><p class="eyebrow">Research / Engineering</p><h1>Research &amp; projects</h1><p>Current research, independent projects, and selected coursework.</p></header>
    {groups.map(group=><section class="work-group" aria-label={group.title}><div class="section-head"><h2>{group.title}</h2></div>{group.projects.map(p=><article class="project-row"><span class="project-number">{String(p.data.order).padStart(2,'0')}</span><div><p class="eyebrow">{p.data.category} / {p.data.status}</p><h3><a href={`/work/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.summary}</p><div class="tags">{p.data.tags.map(t=><span>{t}</span>)}<span>{p.data.period}</span></div></div><a class="row-link" href={`/work/${p.id}/`} aria-label={`Read ${p.data.title}`}>↗</a></article>)}</section>)}
    <section class="section additional-work"><div class="section-head"><h2>Additional coursework</h2></div><div class="additional-grid"><article><p class="eyebrow">Applied data science / Fall 2025</p><h3>Salary prediction</h3><p>A workflow on 742 cleaned Glassdoor job listings, combining model comparison, SHAP interpretation, experiment tracking, and a Streamlit interface.</p><a class="text-link" href="https://github.com/Ansester/salary-prediction-ml" target="_blank" rel="noopener noreferrer">Source code ↗</a></article><article><p class="eyebrow">Statistical modeling / Spring 2025</p><h3>Community crime data analysis</h3><p>Observational regression and single-holdout evaluation across 1,994 U.S. communities, with an application for descriptive exploration.</p><a class="text-link" href="https://github.com/Ansester/crime-prediction-ml" target="_blank" rel="noopener noreferrer">Source code ↗</a></article></div></section>
  </div>
</Layout>
