---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProteinComparison from '../../components/ProteinComparison.astro';
import ValidationExcerpt from '../../components/ValidationExcerpt.astro';
export async function getStaticPaths() {
  return (await getCollection('work')).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const research = ['human-ai-collaboration','protein-language-models','synthetic-pilot-lab'].includes(post.id);
---
<Layout title={`${post.data.title} — Ashmit Mukherjee`} description={post.data.summary}>
  <article class="container case-page">
    <header class="case-header">
      <a class="back-link" href={research ? '/#research' : '/work/'}>← {research ? 'Research' : 'Projects'}</a>
      <p class="byline">{post.data.status} · {post.data.period}</p>
      <h1>{post.data.title}</h1>
      <p class="case-summary">{post.data.summary}</p>
      <p class="case-credit"><strong>{post.data.role}</strong><br />{post.data.organization}</p>
      {post.data.links.length>0 && <div class="inline-links">{post.data.links.map(link=><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div>}
    </header>
    {post.id === 'protein-language-models' && <><p class="comparison-context">This figure shows follow-up experiments on feature injection. The manuscript uses a different method: initializing LoRA with biological information.</p><ProteinComparison detailed /></>}
    <div class="prose"><Content /></div>
    {post.id === 'human-ai-collaboration' && <section class="check-record" id="payoff-check" aria-label="Executed payoff integrity check"><ValidationExcerpt detailed /></section>}
    {!research && <ProjectVisual kind={post.data.visual} />}
    <footer class="case-end"><a href={research ? '/#research' : '/work/'}>{research ? 'Back to research' : 'All projects'}</a>{post.data.updated && <span>Updated {post.data.updated}</span>}</footer>
  </article>
</Layout>
