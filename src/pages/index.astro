---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../ashmit-profile.jpg';
const projects = (await getCollection('work')).sort((a,b)=>a.data.order-b.data.order);
const featured = projects.find(p => p.id === 'human-ai-collaboration')!;
---
<Layout>
  <div class="container">
    <section class="hero">
      <div><p class="eyebrow">Research engineering / Applied ML</p><h1>I build research systems<br /><span>and machine-learning tools.</span></h1><p class="hero-description">I'm Ashmit, a Computer Science student at NYU Abu Dhabi. I build platforms for human–AI experiments and pipelines for training and evaluating protein language models.</p><div class="actions"><a class="button primary" href="#projects">Explore my work <span aria-hidden="true">↓</span></a><a class="text-link" href="/cv.pdf">Download CV ↗</a></div></div>
      <aside class="current"><p class="eyebrow">Currently at NYU Abu Dhabi</p><dl><dt>Human–AI collaboration</dt><dd>Research platform implementation</dd><dt>eBRAIN Lab</dt><dd>Protein language model adaptation</dd><dt>B.S. Computer Science</dt><dd>Expected May 2027</dd></dl></aside>
    </section>
    <section class="section" id="projects"><div class="section-head"><h2>Selected work</h2><a class="text-link" href="/work/">All work ↗</a></div><article class="featured"><div class="featured-copy"><span class="eyebrow">01 / Research systems</span><h3>{featured.data.title}</h3><p>{featured.data.summary}</p><div class="tags"><span>Technical implementation</span><span>Experimental workflows</span><span>Validation</span></div><a class="text-link" href="/work/human-ai-collaboration/">Inside the project ↗</a></div><div class="system-visual" role="img" aria-label="Conceptual flow from research requirements to experimental workflows and structured records"><p class="eyebrow">From question to data</p><div class="flow-step"><span>01</span>Research requirements</div><div class="flow-connector" aria-hidden="true">↓</div><div class="flow-step"><span>02</span>Experimental workflows</div><div class="flow-connector" aria-hidden="true">↓</div><div class="flow-step"><span>03</span>Structured records</div><p class="visual-caption">Conceptual system overview</p></div></article></section>
    <div class="home-projects">{projects.filter(p => p.id !== featured.id).slice(0,2).map((p,i)=><article class="project-row"><span class="project-number">0{i+2}</span><div><h3><a href={`/work/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.summary}</p><div class="tags">{p.data.tags.map(t=><span>{t}</span>)}</div></div><a class="row-link" href={`/work/${p.id}/`} aria-label={`Read ${p.data.title}`}>↗</a></article>)}</div>
    <section class="section split" id="research"><div><p class="eyebrow">Research</p><h2>Build carefully.<br />Evaluate critically.</h2></div><div><p>I am interested in computational social science, experimental research, and applied machine learning. The connecting thread is the full empirical cycle: turn a question into a system or model, test it, and work out what the evidence supports.</p><p class="muted">My current work spans human–AI experimental infrastructure and protein language model adaptation. Earlier, I worked on named-entity recognition in Hindi–English code-mixed text.</p><div class="inline-links"><a class="text-link" href="/work/protein-language-models/">Model adaptation ↗</a><a class="text-link" href="/work/hinglish-ner/">Hinglish NER ↗</a></div></div></section>
    <section class="section split" id="experience"><div><p class="eyebrow">Experience</p><h2>Where I work.</h2></div><ol class="timeline"><li><strong>Research Assistant · Human–AI Collaboration</strong><time>Feb 2026 — present</time><p>NYU Abu Dhabi. Technical implementation, study design, and experimental data workflows.</p></li><li><strong>Research Assistant · eBRAIN Lab</strong><time>Feb 2026 — present</time><p>NYU Abu Dhabi. Model adaptation, evaluation pipelines, and repeated HPC experiments.</p></li><li><strong>ML Engineer Intern · Zeek</strong><time>Jun — Aug 2025</time><p>Customer segmentation, preprocessing and model comparison, and SHAP analysis.</p></li></ol></section>
    <section class="section split" id="about"><div><p class="eyebrow">A little about me</p><h2>From questions<br />to working systems.</h2></div><div class="about-grid" id="background"><div><p>I enjoy the work between an open-ended question and something you can actually test. That has taken me from multilingual NLP and applied data analysis to experimental platforms and protein models.</p><p class="muted">I'm studying Computer Science at NYU Abu Dhabi, graduating in May 2027, with study-away experience in Paris and New York. Outside my technical work, I've supported first-year students and worked with the NYU Abu Dhabi Arts Center.</p><div class="inline-links"><a class="text-link" href="/cv.pdf">Full experience &amp; skills ↗</a></div></div><Image class="portrait" src={portrait} alt="Ashmit Mukherjee" width={160} height={160} format="webp" loading="lazy" /></div></section>
  </div>
</Layout>
